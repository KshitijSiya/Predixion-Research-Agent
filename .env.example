# ==============================================================================
# Predixion AI Research Agent - Environment Configuration
# ==============================================================================

# Primary LLM Provider: Groq (Llama-3.3-70B)
# Get a free API key in 30 seconds at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Failover LLM Provider: Google Gemini
# Optional backup if Groq experiences rate limits or downtime
# Get a free API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Tool & Network Settings
SEARCH_BACKEND=duckduckgo       # duckduckgo (zero-key required)
MAX_SEARCH_RESULTS=5
SCRAPE_TIMEOUT_SECONDS=8
MAX_CONTENT_TOKENS_PER_PAGE=2500

# Application Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
